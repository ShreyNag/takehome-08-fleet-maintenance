# Copy this to .env for local development and fill in real values.
# On Render, set these as environment variables in the dashboard instead of
# committing a .env file there.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True locally, False in production.
DEBUG=True

# Comma-separated hostnames this app is allowed to serve, e.g.:
# localhost,127.0.0.1,fleetcare.onrender.com
ALLOWED_HOSTS=

# Comma-separated origins allowed to POST cross-site with a CSRF token.
# Must include the scheme, e.g.: https://fleetcare.onrender.com
CSRF_TRUSTED_ORIGINS=

# Full connection string. Leave unset locally to fall back to sqlite.
# Neon example: postgres://user:password@ep-xxxx.neon.tech/fleetcare?sslmode=require
DATABASE_URL=
